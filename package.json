{
  "name": "starter-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:preview": "node scripts/seed-preview.mjs",
    "dictionary:check": "node scripts/check-dictionary.mjs",
    "migration:check": "node scripts/migration-check.mjs",
    "gen:agents": "node scripts/gen-agent-files.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && node scripts/gen-agent-files.mjs --check && pnpm dictionary:check && pnpm test:unit && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "Greenfield starter-app: a small-business web app template (Next.js + Postgres + Drizzle) managed through Greenfield Swarm.",
  "engines": {
    "node": ">=22"
  }
}
